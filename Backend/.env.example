# ==============================================================================
# Automate Backend Environment Configuration
# ==============================================================================
# This file defines all environment variables required by the Automate backend.
# Copy this file to '.env' to run the application locally in development mode:
#
#   copy .env.example .env     (Windows Command Prompt)
#   cp .env.example .env       (Bash / PowerShell)
#
# If no '.env' file is present, the application will automatically initialize one
# from this template upon startup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
# APP_NAME: The human-readable name of the application displayed in API docs and logs.
APP_NAME=Automate API

# APP_VERSION: Semantic version of the running application.
APP_VERSION=1.0.0

# APP_ENV: Runtime environment ('development', 'staging', 'production', 'testing').
# In 'development', detailed debug logs for OCR and AI services are printed to stdout.
APP_ENV=development

# ------------------------------------------------------------------------------
# 2. Server Network Settings
# ------------------------------------------------------------------------------
# HOST: IP address or hostname to bind the Uvicorn web server.
# Use 127.0.0.1 for local development, or 0.0.0.0 to expose on network / Docker.
HOST=0.0.0.0

# PORT: TCP port number on which the backend server will listen for requests.
PORT=8000

# ------------------------------------------------------------------------------
# 3. Database Settings (MongoDB)
# ------------------------------------------------------------------------------
# MONGODB_URI: MongoDB connection string URI.
# Local default:  mongodb://localhost:27017 or mongodb://127.0.0.1:27017
# MongoDB Atlas:  mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# DATABASE_NAME: The database name in MongoDB used to store collections.
DATABASE_NAME=admiextract

# ------------------------------------------------------------------------------
# 4. Security & Authentication Settings (JWT)
# ------------------------------------------------------------------------------
# SECRET_KEY: Cryptographic secret key used to sign and verify JWT authentication tokens.
# WARNING: In production environments, generate a secure random 64-character hex key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-in-production-admiextract-2026

# ALGORITHM: Cryptographic hashing algorithm used for signing JWT tokens (e.g. HS256).
ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES: Lifetime of issued JWT access tokens in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 5. AI & OCR Service Settings (Google Gemini & Mistral)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API Key for multimodal document extraction (OCR + vision + layout)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# MISTRAL_API_KEY: API key for Mistral AI SDK (optional fallback)
MISTRAL_API_KEY=
